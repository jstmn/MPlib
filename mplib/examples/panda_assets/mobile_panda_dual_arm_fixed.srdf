<?xml version="1.0" ?>
<robot name="mobile_panda_dual_arm">
    <group name="dual_arm">
        <joint name="root_x_axis_joint"/>
        <joint name="root_y_axis_joint"/>
        <joint name="root_z_rotation_joint"/>
        <joint name="linear_actuator_height"/>
        
        <joint name="right_panda_joint1"/>
        <joint name="right_panda_joint2"/>
        <joint name="right_panda_joint3"/>
        <joint name="right_panda_joint4"/>
        <joint name="right_panda_joint5"/>
        <joint name="right_panda_joint6"/>
        <joint name="right_panda_joint7"/>

        <joint name="left_panda_joint1"/>
        <joint name="left_panda_joint2"/>
        <joint name="left_panda_joint3"/>
        <joint name="left_panda_joint4"/>
        <joint name="left_panda_joint5"/>
        <joint name="left_panda_joint6"/>
        <joint name="left_panda_joint7"/>
    </group>
    <disable_collisions link1="adjustable_body" link2="body_base_link" reason="Default"/>
    <disable_collisions link1="body_base_link" link2="body_link" reason="Default"/>
    <disable_collisions link1="body_link" link2="left_panda_link1" reason="Default"/>
    <disable_collisions link1="body_link" link2="right_panda_link1" reason="Default"/>
    <disable_collisions link1="left_panda_link1" link2="left_panda_link2" reason="Default"/>
    <disable_collisions link1="left_panda_link3" link2="left_panda_link4" reason="Default"/>
    <disable_collisions link1="left_panda_link4" link2="left_panda_link5" reason="Default"/>
    <disable_collisions link1="left_panda_link5" link2="left_panda_link6" reason="Default"/>
    <disable_collisions link1="left_panda_link7" link2="left_panda_hand" reason="Default"/>
    <disable_collisions link1="left_panda_hand" link2="left_panda_leftfinger" reason="Default"/>
    <disable_collisions link1="left_panda_hand" link2="left_panda_rightfinger" reason="Default"/>
    <disable_collisions link1="right_panda_link1" link2="right_panda_link2" reason="Default"/>
    <disable_collisions link1="right_panda_link3" link2="right_panda_link4" reason="Default"/>
    <disable_collisions link1="right_panda_link4" link2="right_panda_link5" reason="Default"/>
    <disable_collisions link1="right_panda_link5" link2="right_panda_link6" reason="Default"/>
    <disable_collisions link1="right_panda_link7" link2="right_panda_hand" reason="Default"/>
    <disable_collisions link1="right_panda_hand" link2="right_panda_leftfinger" reason="Default"/>
    <disable_collisions link1="right_panda_hand" link2="right_panda_rightfinger" reason="Default"/>
    <disable_collisions link1="right_panda_link5" link2="right_panda_link7" reason="Default"/>
    <disable_collisions link1="right_panda_link5" link2="right_panda_hand" reason="Default"/>
    <disable_collisions link1="right_panda_link5" link2="right_panda_rightfinger" reason="Default"/>
    <disable_collisions link1="right_panda_link5" link2="right_panda_leftfinger" reason="Default"/>
    <disable_collisions link1="left_panda_link5" link2="left_panda_link7" reason="Default"/>
    <disable_collisions link1="left_panda_link5" link2="left_panda_hand" reason="Default"/>
    <disable_collisions link1="left_panda_link5" link2="left_panda_rightfinger" reason="Default"/>
    <disable_collisions link1="left_panda_link5" link2="left_panda_leftfinger" reason="Default"/>
</robot>
